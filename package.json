{
  "name": "sinisteroid-next",
  "version": "2.1.0",
  "private": true,
  "description": "Omid – Frontend Developer Portfolio (Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "extract-posts": "node scripts/extract-posts.mjs",
    "import-posts": "node scripts/import-posts.mjs",
    "prepare-cpanel": "node scripts/prepare-cpanel.mjs",
    "zip-out": "node scripts/zip-out.mjs",
    "deploy": "npm run build && npm run prepare-cpanel && npm run zip-out"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "chromeandroid >= 100",
    "firefoxandroid >= 100",
    "samsung >= 17",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ]
}
